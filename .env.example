# Frontend public configuration only
VITE_API_BASE_URL=

# Backend (server-side only; never expose as VITE_ variables)
NODE_ENV=development
PORT=3001
PUBLIC_APP_URL=http://localhost:5173
TRUSTED_PROXY_HOPS=0
DATABASE_URL=postgresql://domainhub:domainhub@localhost:5432/domainhub
SESSION_COOKIE_NAME=__Host-domainhub_session
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=604800
SESSION_HASH_PEPPER=replace-with-a-long-random-secret
CSRF_SECRET=replace-with-a-different-long-random-secret
TOKEN_HASH_PEPPER=replace-with-a-long-random-secret
RATE_LIMIT_HMAC_KEY=replace-with-a-long-random-secret

# SMTP adapter; when unset, non-production uses in-memory mock delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=DomainHub <no-reply@example.com>
MAIL_REPLY_TO=
